#!/bin/sh
# Last local gate before GitHub: every commit being pushed (contents, messages, author).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
# With a TypeSafe key, also ask Jev about personal data and private-project material in the added text
# (set PUBLIC_SAFETY_JEV=0 to skip). It sends only what is about to become public.
jev=""
if [ -n "$TYPESAFE_API_KEY" ] && [ "${PUBLIC_SAFETY_JEV:-1}" != "0" ]; then jev="--jev"; fi
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range="..$local_sha"; else range="$remote_sha..$local_sha"; fi
  python3 "$root/scripts/public_safety_check.py" --range "$range" $jev || status=1
done
exit $status
